{
    "name": "agent-blocks-spa-documentation",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsc -p app/tsconfig.build.json",
        "typecheck": "tsc -p app/tsconfig.json && tsc -p app_tests/tsconfig.json",
        "test": "node --test --test-concurrency=1 browser_tests/*.test.mjs",
        "test:headed": "WSLENV=SPA_TEST_HEADED:SPA_TEST_SLOW_MO:SPA_TEST_HOLD_OPEN_MS SPA_TEST_HEADED=1 SPA_TEST_SLOW_MO=350 SPA_TEST_HOLD_OPEN_MS=10000 node.exe --test --test-concurrency=1 browser_tests/*.test.mjs"
    },
    "devDependencies": {
        "playwright-core": "1.62.1",
        "typescript": "5.8.3"
    }
}
